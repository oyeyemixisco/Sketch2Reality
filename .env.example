# Copy this file to .env; .env is ignored by Git.
# Use "mock" for offline placeholder previews, or "kaggle" for real generation through Kaggle + ngrok.
SKETCH2FUTURE_BACKEND=kaggle
# Paste the public HTTPS URL produced by the Kaggle notebook (no trailing slash).
KAGGLE_API_URL=https://your-current-tunnel.ngrok-free.app
# SAME value as the SKETCH2FUTURE_API_KEY secret in Kaggle.
KAGGLE_API_KEY=replace-with-your-own-long-random-secret-minimum-24-characters
# Comparisons and four-run LoRA Lab experiments may take several minutes.
KAGGLE_CONNECT_TIMEOUT=10
KAGGLE_READ_TIMEOUT=1800
